# Fashion Forward Blog - Environment Configuration
# Copy this file to .env and update with your values

# Optional: OpenAI API key for enhanced content generation
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom secret key for session security
# Generate a strong random key for production
# SECRET_KEY=your_secret_key_here

# Optional: Application settings
# DEBUG=false
# HOST=0.0.0.0
# PORT=5000

# Optional: Database URL (defaults to SQLite)
# DATABASE_URL=sqlite:///fashion_blog.db

# Note: All settings have defaults in config.py
# Only add variables here if you want to override the defaults